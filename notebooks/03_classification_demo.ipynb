    "## 6. Risk Score Distribution Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d65104eb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Risk score distributions and threshold analysis\n",
    "fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n",
    "\n",
    "# Risk probability distribution by true label\n",
    "axes[0].hist(df[df['depression_label']==0]['risk_probability'],\n",
    "             bins=20, alpha=0.7, color='#4CAF50',\n",
    "             label='No Risk (True)', density=True)\n",
    "axes[0].hist(df[df['depression_label']==1]['risk_probability'],\n",
    "             bins=20, alpha=0.7, color='#F44336',\n",
    "             label='At Risk (True)', density=True)\n",
    "axes[0].axvline(x=0.5, color='black', linestyle='--',\n",
    "                linewidth=2, label='Decision threshold (0.5)')\n",
    "axes[0].set_xlabel('Risk Probability')\n",
    "axes[0].set_ylabel('Density')\n",
    "axes[0].set_title('Risk Score Distribution\\nby True Label', fontweight='bold')\n",
    "axes[0].legend(fontsize=9)\n",
    "\n",
    "# Threshold optimisation\n",
    "thresholds = np.arange(0.1, 0.9, 0.05)\n",
    "sensitivities = []\n",
    "specificities = []\n",
    "f1_scores = []\n",
    "\n",
    "for thresh in thresholds:\n",
    "    preds = (df['risk_probability'] >= thresh).astype(int)\n",
    "    tp = ((preds == 1) & (df['depression_label'] == 1)).sum()\n",
    "    tn = ((preds == 0) & (df['depression_label'] == 0)).sum()\n",
    "    fp = ((preds == 1) & (df['depression_label'] == 0)).sum()\n",
    "    fn = ((preds == 0) & (df['depression_label'] == 1)).sum()\n",
    "    \n",
    "    sens = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
    "    spec = tn / (tn + fp) if (tn + fp) > 0 else 0\n",
    "    f1 = 2*tp / (2*tp + fp + fn) if (2*tp + fp + fn) > 0 else 0\n",
    "    \n",
    "    sensitivities.append(sens)\n",
    "    specificities.append(spec)\n",
    "    f1_scores.append(f1)\n",
    "\n",
    "axes[1].plot(thresholds, sensitivities, 'r-o', markersize=4,\n",
    "             label='Sensitivity (Recall)', linewidth=2)\n",
    "axes[1].plot(thresholds, specificities, 'g-s', markersize=4,\n",
    "             label='Specificity', linewidth=2)\n",
    "axes[1].plot(thresholds, f1_scores, 'b-^', markersize=4,\n",
    "             label='F1 Score', linewidth=2)\n",
    "axes[1].axvline(x=0.5, color='gray', linestyle='--', alpha=0.7)\n",
    "\n",
    "# Find optimal threshold (maximise F1)\n",
    "optimal_idx = np.argmax(f1_scores)\n",
    "optimal_thresh = thresholds[optimal_idx]\n",
    "axes[1].axvline(x=optimal_thresh, color='purple', linestyle=':',\n",
    "                linewidth=2, label=f'Optimal threshold ({optimal_thresh:.2f})')\n",
    "axes[1].set_xlabel('Classification Threshold')\n",
    "axes[1].set_ylabel('Score')\n",
    "axes[1].set_title('Threshold Optimisation\\n(Sensitivity vs Specificity)', fontweight='bold')\n",
    "axes[1].legend(fontsize=8)\n",
    "axes[1].set_ylim([0, 1.05])\n",
    "\n",
    "# Risk tier distribution\n",
    "df['risk_tier'] = pd.cut(df['risk_probability'],\n",
    "                          bins=[0, 0.3, 0.65, 1.0],\n",
    "                          labels=['🟢 Low (0-30%)', '🟡 Medium (31-65%)', '🔴 High (66-100%)'])\n",
    "tier_counts = df.groupby(['risk_tier', 'depression_label']).size().unstack(fill_value=0)\n",
    "\n",
    "colors = ['#4CAF50', '#F44336']\n",
    "tier_counts.plot(kind='bar', ax=axes[2], color=colors, alpha=0.8)\n",
    "axes[2].set_title('Depression Risk by\\nPipeline Tier Category', fontweight='bold')\n",
    "axes[2].set_xlabel('Risk Tier')\n",
    "axes[2].set_ylabel('Number of Posts')\n",
    "axes[2].legend(['No Risk', 'At Risk'])\n",
    "axes[2].tick_params(axis='x', rotation=15)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('risk_distribution.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(f\"\\n📊 Optimal Decision Threshold: {optimal_thresh:.2f}\")\n",
    "print(f\"   At this threshold:\")\n",
    "print(f\"   Sensitivity: {sensitivities[optimal_idx]:.1%} (catching at-risk individuals)\")\n",
    "print(f\"   Specificity: {specificities[optimal_idx]:.1%} (avoiding false alarms)\")\n",
    "print(f\"   F1 Score:    {f1_scores[optimal_idx]:.3f}\")\n",
    "print(f\"\\n💡 Clinical Note: In mental health screening, sensitivity > specificity\")\n",
    "print(f\"   Missing a high-risk individual is worse than a false alarm\")\n"
   ]
  },
