    "def visualise_attention(text, tokenizer, model, device, title=\"\"):\n",
    "    \"\"\"Visualise attention weights for a single text.\"\"\"\n",
    "    result = classify_text(text, tokenizer, model, device)\n",
    "    \n",
    "    if result['attention'] is None:\n",
    "        print(\"Attention weights not available\")\n",
    "        return\n",
    "    \n",
    "    tokens = [t for t, _ in result['tokens']]\n",
    "    indices = [i for _, i in result['tokens']]\n",
    "    \n",
    "    if not tokens:\n",
    "        print(\"No tokens to visualise\")\n",
    "        return\n",
    "    \n",
    "    # Get attention scores for real tokens\n",
    "    attn_scores = result['attention'][indices]\n",
    "    attn_scores = attn_scores / attn_scores.sum()  # Normalise\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(max(10, len(tokens)*0.8), 2.5))\n",
    "    \n",
    "    # Colour by attention weight\n",
    "    colors = plt.cm.RdYlGn_r(attn_scores)\n",
    "    \n",
    "    for i, (token, score, color) in enumerate(zip(tokens, attn_scores, colors)):\n",
    "        rect = mpatches.FancyBboxPatch(\n",
    "            (i*1.1, 0.3), 1.0, 0.4,\n",
    "            boxstyle=\"round,pad=0.05\",\n",
    "            facecolor=color, edgecolor='gray', linewidth=0.5\n",
    "        )\n",
    "        ax.add_patch(rect)\n",
    "        ax.text(i*1.1 + 0.5, 0.5, token,\n",
    "                ha='center', va='center', fontsize=9, fontweight='bold')\n",
    "        ax.text(i*1.1 + 0.5, 0.25, f'{score:.2f}',\n",
    "                ha='center', va='center', fontsize=7, color='gray')\n",
    "    \n",
    "    risk_color = '#F44336' if result['prediction'] == 1 else '#4CAF50'\n",
    "    ax.set_title(\n",
    "        f\"{title}\\n{result['prediction_label']} | \"\n",
    "        f\"Risk: {result['risk_probability']:.1%}\",\n",
    "        fontweight='bold', color=risk_color\n",
    "    )\n",
    "    ax.set_xlim(-0.1, len(tokens)*1.1 + 0.1)\n",
    "    ax.set_ylim(0, 1)\n",
    "    ax.axis('off')\n",
    "    \n",
    "    # Colorbar\n",
    "    sm = plt.cm.ScalarMappable(cmap='RdYlGn_r',\n",
    "                                norm=plt.Normalize(vmin=0, vmax=1))\n",
    "    plt.colorbar(sm, ax=ax, label='Attention Weight',\n",
    "                 orientation='horizontal', fraction=0.02, pad=0.01)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    return fig\n",
    "\n",
